{
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.py",
    "padding": 0,
    "refreshInterval": 30
  },
  "permissions": {
    "allow": [
      "Bash(herdr *)",
      "Bash(~/.claude/scripts/start-agent.sh *)",
      "Bash(~/.claude/scripts/server-pane.sh *)",
      "Bash(python3 *)",
      "Bash(cd *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(stat *)",
      "Bash(which *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git rev-list*)",
      "Bash(git worktree list*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(curl -s localhost*)",
      "Bash(curl -s http://localhost*)",
      "Bash(curl -s -X POST localhost*)",
      "Bash(curl -s -o /dev/null *localhost*)",
      "Bash(lsof *)",
      "Bash(ps *)",
      "Bash(top -l *)",
      "Bash(vm_stat*)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(mypy *)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose build*)",
      "Bash(docker compose up*)",
      "Bash(docker ps*)"
    ]
  }
}